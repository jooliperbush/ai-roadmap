# Meta WhatsApp Cloud API (leave unset to run with the simulated transport)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
# Optional: enables Claude-backed intent parsing for free-text replies.
# Unset = rule-based parser only (still fully functional).
ANTHROPIC_API_KEY=
PORT=3000
